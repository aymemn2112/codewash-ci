#!/bin/sh
# Local safety net: runs the same checks as CI before a push.
# Enable once with: git config core.hooksPath .githooks
# Bypass only in an emergency: git push --no-verify
set -e

root="$(git rev-parse --show-toplevel)"
cd "$root/CodeWashGame"

echo "[pre-push] lint"
npm run lint

echo "[pre-push] format check"
npm run format:check

echo "[pre-push] tests + coverage"
npm run coverage

echo "[pre-push] build"
npm run build

echo "[pre-push] all checks passed"